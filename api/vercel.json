{
  "buildCommand": "prisma generate",
  "outputDirectory": "public",
  "routes": [
    { "handle": "filesystem" },
    { "src": "^/api/_app$", "dest": "/api/_app" },
    { "src": "^/api/(?!_app(?:/|\\?|$)|health$|auth/admin/login$|auth/admin/me$)(.*)$", "dest": "/api/_app" }
  ],
  "functions": {
    "api/_app.ts": {
      "memory": 256
    },
    "api/health.ts": {
      "memory": 256
    },
    "api/auth/admin/login.ts": {
      "memory": 256
    },
    "api/auth/admin/me.ts": {
      "memory": 256
    }
  }
}