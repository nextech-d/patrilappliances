{
  "buildCommand": "prisma generate",
  "outputDirectory": "public",
  "functions": {
    "api/[[...route]].ts": {
      "includeFiles": "{prisma/**,node_modules/.prisma/**,node_modules/@prisma/client/**}"
    },
    "api/health.ts": {
      "memory": 256
    },
    "api/auth/admin/login.ts": {
      "memory": 256
    }
  }
}