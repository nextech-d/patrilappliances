{
  "buildCommand": "prisma generate",
  "outputDirectory": "public",
  "routes": [
    { "handle": "filesystem" },
    { "src": "/api/(.*)", "dest": "/api" }
  ],
  "functions": {
    "api/index.ts": {
      "includeFiles": "prisma/**",
      "memory": 1024
    },
    "api/health.ts": {
      "memory": 256
    },
    "api/auth/admin/login.ts": {
      "memory": 256
    },
    "api/auth/admin/me.ts": {
      "memory": 256
    }
  }
}