DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require
PORT=4000

# Admin JWT signing secret (use a long random string in production)
ADMIN_JWT_SECRET=change-me-to-a-long-random-secret
ADMIN_PASSWORD=change-me-to-a-strong-password

# Comma-separated origins for CORS (store + admin URLs)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

RESEND_API_KEY=
EMAIL_FROM=Patril Appliances <onboarding@resend.dev>
ORDER_NOTIFY_EMAIL=hello@patrilappliances.com
SITE_URL=https://patrilappliances.vercel.app

# Product image uploads — use Vercel Blob in production (local dev uses public/uploads/)
BLOB_READ_WRITE_TOKEN=
