# Copy to .env.local for local development.
# In Vercel: Project → Settings → Environment Variables

# Neon Postgres (required for database-backed catalog)
# Create free project at https://neon.tech — paste the connection string here.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# Admin panel (/admin) — pick a strong password; never commit the real value
ADMIN_PASSWORD=change-me-to-a-strong-password

# Order email notifications (optional — Resend: https://resend.com)
RESEND_API_KEY=
EMAIL_FROM=Patril Appliances <onboarding@resend.dev>
ORDER_NOTIFY_EMAIL=hello@patrilappliances.com

# Staging: keep true until payments + database are fully live.
NEXT_PUBLIC_DEMO_MODE=true

# Public site URL for SEO (sitemap, Open Graph). Use your custom domain when ready.
NEXT_PUBLIC_SITE_URL=https://patrilappliances.vercel.app

# Contact & social (optional — defaults exist in app/config/site.ts)
NEXT_PUBLIC_WHATSAPP_NUMBER=254700000000
NEXT_PUBLIC_FACEBOOK_URL=https://facebook.com/patrillappliances
NEXT_PUBLIC_INSTAGRAM_URL=https://instagram.com/patrillappliances
NEXT_PUBLIC_TIKTOK_URL=https://tiktok.com/@patrillappliances
